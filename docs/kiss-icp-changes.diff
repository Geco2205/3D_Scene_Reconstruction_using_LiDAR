diff -ruN a/core/GpuAssociation.hpp b/core/GpuAssociation.hpp
--- a/core/GpuAssociation.hpp	1970-01-01 00:00:00.000000000 +0000
+++ b/core/GpuAssociation.hpp	2026-10-28 06:59:44.539474212 +0000
@@ -0,0 +1,163 @@
+// GpuAssociation.hpp - optional GPU offload of DataAssociation (library gpu_assoc).
+//
+// Compiled only when KISS_ICP_USE_GPU is defined. At runtime it is enabled with the
+// environment variable KISS_USE_GPU=1; otherwise Enabled() is false and nothing changes.
+//
+// The local map does not change during the ICP loop, so it is flattened and uploaded once
+// per scan (SetMap), and every iteration only sends the source points (Associate).
+// If any GPU call fails, the error is reported on stderr, counted in "gpu_fallbacks", and
+// that scan finishes on the CPU, so a GPU problem never silently changes the result.
+#pragma once
+
+#ifdef KISS_ICP_USE_GPU
+
+#include <Eigen/Core>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+#include <vector>
+
+#include "ProfileTimers.hpp"
+#include "VoxelHashMap.hpp"
+#include "gpu_associate.h"
+
+namespace kiss_icp::gpu {
+
+using Correspondence = std::pair<Eigen::Vector3d, Eigen::Vector3d>;
+using Correspondences = std::vector<Correspondence>;
+
+// Capacities reserved once on the GPU (about 27 MB in total). They are far above the maxima
+// measured on a 300-scan sample (8139 voxels, 131194 map points, 2096 scan points).
+// A scan that exceeds them makes the GPU call fail and that scan runs on the CPU.
+constexpr int kMaxVoxels = 65536;
+constexpr int kMaxMapPoints = 1048576;
+constexpr int kMaxSourcePoints = 16384;
+
+class Session {
+public:
+    static Session &Get() {
+        static Session session;
+        return session;
+    }
+
+    bool enabled() const { return ready_; }
+
+    // Flattens the voxel map and uploads it. Returns false if the scan must use the CPU.
+    bool SetMap(const VoxelHashMap &map) {
+        map_loaded_ = false;
+        {
+            KISS_TIMER("gpu_flatten_map");
+            coords_.clear();
+            start_.clear();
+            count_.clear();
+            map_pts_.clear();
+            for (const auto &kv : map.map_) {
+                coords_.push_back(kv.first.x());
+                coords_.push_back(kv.first.y());
+                coords_.push_back(kv.first.z());
+                start_.push_back(static_cast<int>(map_pts_.size() / 3));
+                count_.push_back(static_cast<int>(kv.second.points.size()));
+                for (const auto &p : kv.second.points) {
+                    map_pts_.push_back(p.x());
+                    map_pts_.push_back(p.y());
+                    map_pts_.push_back(p.z());
+                }
+            }
+        }
+        const int n_vox = static_cast<int>(start_.size());
+        const int n_pts = static_cast<int>(map_pts_.size() / 3);
+        int rc = 0;
+        {
+            KISS_TIMER("gpu_set_map");
+            rc = gpu_set_map(map.voxel_size_, n_vox, coords_.data(), start_.data(), count_.data(),
+                             n_pts, map_pts_.data());
+        }
+        if (rc != 0) {
+            Fail("gpu_set_map", rc);
+            return false;
+        }
+        map_loaded_ = true;
+        return true;
+    }
+
+    // Nearest-neighbour search for every source point. Returns false on failure.
+    bool Associate(const std::vector<Eigen::Vector3d> &source,
+                   const double max_distance,
+                   Correspondences &out) {
+        if (!map_loaded_) return false;  // SetMap already failed and was counted
+        const std::size_t n = source.size();
+        out.clear();
+        if (n == 0) return true;
+        {
+            KISS_TIMER("gpu_flatten_source");
+            src_.resize(3 * n);
+            for (std::size_t i = 0; i < n; ++i) {
+                src_[3 * i] = source[i].x();
+                src_[3 * i + 1] = source[i].y();
+                src_[3 * i + 2] = source[i].z();
+            }
+        }
+        out_.resize(n);
+        int rc = 0;
+        {
+            KISS_TIMER("gpu_run");
+            rc = gpu_run(static_cast<int>(n), src_.data(), max_distance, out_.data());
+        }
+        if (rc != 0) {
+            Fail("gpu_run", rc);
+            return false;
+        }
+        {
+            KISS_TIMER("gpu_build_pairs");
+            out.reserve(n);
+            for (std::size_t i = 0; i < n; ++i) {
+                const int idx = out_[i];
+                if (idx < 0) continue;
+                const std::size_t k = 3 * static_cast<std::size_t>(idx);
+                out.emplace_back(source[i],
+                                 Eigen::Vector3d(map_pts_[k], map_pts_[k + 1], map_pts_[k + 2]));
+            }
+        }
+        ::kiss_icp::prof::Count("gpu_iterations", 1.0);
+        return true;
+    }
+
+private:
+    Session() {
+        const char *flag = std::getenv("KISS_USE_GPU");
+        if (flag == nullptr || std::strcmp(flag, "1") != 0) return;
+        const int rc = gpu_init(kMaxVoxels, kMaxMapPoints, kMaxSourcePoints);
+        if (rc != 0) {
+            std::fprintf(stderr, "gpu: gpu_init failed (code %d); running on the CPU\n", rc);
+            return;
+        }
+        ready_ = true;
+    }
+    ~Session() {
+        if (ready_) gpu_free();
+    }
+
+    static void Fail(const char *what, const int rc) {
+        std::fprintf(stderr, "gpu: %s failed (code %d); this scan runs on the CPU\n", what, rc);
+        ::kiss_icp::prof::Count("gpu_fallbacks", 1.0);
+    }
+
+    bool ready_ = false;
+    bool map_loaded_ = false;
+    std::vector<int> coords_, start_, count_, out_;
+    std::vector<double> map_pts_, src_;
+};
+
+inline bool Enabled() { return Session::Get().enabled(); }
+inline bool SetMap(const VoxelHashMap &map) { return Session::Get().SetMap(map); }
+inline bool Associate(const std::vector<Eigen::Vector3d> &source,
+                      const double max_distance,
+                      Correspondences &out) {
+    return Session::Get().Associate(source, max_distance, out);
+}
+
+}  // namespace kiss_icp::gpu
+
+#endif  // KISS_ICP_USE_GPU
diff -ruN a/core/ProfileTimers.hpp b/core/ProfileTimers.hpp
--- a/core/ProfileTimers.hpp	1970-01-01 00:00:00.000000000 +0000
+++ b/core/ProfileTimers.hpp	2026-10-28 06:59:44.539771740 +0000
@@ -0,0 +1,120 @@
+// Temporizadores ligeros (std::chrono) para perfilar KISS-ICP por dentro.
+// Se aplica como parche (patches/kiss-icp-timers.patch); no forma parte de KISS-ICP.
+//
+// Al terminar el programa imprime en stderr una tabla con las llamadas, el tiempo
+// total y el tiempo medio de cada region, mas unos contadores. Si la variable de
+// entorno KISS_PROFILE_OUT apunta a un archivo, tambien escribe un CSV.
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace kiss_icp::prof {
+
+struct Entry {
+    std::string name;
+    std::uint64_t calls = 0;
+    double total = 0.0;  // ms para temporizadores, suma de valores para contadores
+    double max = 0.0;
+};
+
+class Registry {
+public:
+    ~Registry() { Report(); }
+
+    void AddTime(const char *name, double ms) { Add(timers_, name, ms); }
+    void AddCount(const char *name, double value) { Add(counters_, name, value); }
+
+private:
+    static double Mean(const Entry &e) { return e.total / static_cast<double>(e.calls); }
+
+    void Add(std::vector<Entry> &v, const char *name, double value) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        auto it = std::find_if(v.begin(), v.end(), [&](const Entry &e) { return e.name == name; });
+        if (it == v.end()) {
+            v.push_back(Entry{name});
+            it = v.end() - 1;
+        }
+        it->calls += 1;
+        it->total += value;
+        it->max = std::max(it->max, value);
+    }
+
+    void Report() const {
+        if (timers_.empty() && counters_.empty()) return;
+        double ref = 0.0;
+        for (const auto &e : timers_)
+            if (e.name == "register_frame") ref = e.total;
+
+        std::fprintf(stderr, "\n=== KISS-ICP: tiempos internos (std::chrono, pared, ms) ===\n");
+        std::fprintf(stderr, "%-22s %8s %12s %12s %10s %8s\n", "region", "llamadas", "total",
+                     "media", "max", "% frame");
+        for (const auto &e : timers_) {
+            std::fprintf(stderr, "%-22s %8llu %12.2f %12.3f %10.2f %7.1f%%\n", e.name.c_str(),
+                         static_cast<unsigned long long>(e.calls), e.total, Mean(e),
+                         e.max, ref > 0.0 ? 100.0 * e.total / ref : 0.0);
+        }
+        std::fprintf(stderr, "\n%-22s %8s %14s %12s %10s\n", "contador", "eventos", "suma", "media",
+                     "max");
+        for (const auto &e : counters_) {
+            std::fprintf(stderr, "%-22s %8llu %14.0f %12.2f %10.0f\n", e.name.c_str(),
+                         static_cast<unsigned long long>(e.calls), e.total, Mean(e),
+                         e.max);
+        }
+        std::fprintf(stderr, "\n");
+
+        if (const char *path = std::getenv("KISS_PROFILE_OUT")) {
+            if (FILE *f = std::fopen(path, "w")) {
+                std::fprintf(f, "tipo,nombre,eventos,total,media,max\n");
+                for (const auto &e : timers_)
+                    std::fprintf(f, "tiempo_ms,%s,%llu,%.4f,%.5f,%.4f\n", e.name.c_str(),
+                                 static_cast<unsigned long long>(e.calls), e.total,
+                                 Mean(e), e.max);
+                for (const auto &e : counters_)
+                    std::fprintf(f, "contador,%s,%llu,%.0f,%.3f,%.0f\n", e.name.c_str(),
+                                 static_cast<unsigned long long>(e.calls), e.total,
+                                 Mean(e), e.max);
+                std::fclose(f);
+            }
+        }
+    }
+
+    std::mutex mutex_;
+    std::vector<Entry> timers_;
+    std::vector<Entry> counters_;
+};
+
+inline Registry &GetRegistry() {
+    static Registry registry;  // se destruye al terminar el programa e imprime el informe
+    return registry;
+}
+
+class ScopedTimer {
+public:
+    explicit ScopedTimer(const char *name)
+        : name_(name), t0_(std::chrono::steady_clock::now()) {}
+    ~ScopedTimer() {
+        const auto dt = std::chrono::steady_clock::now() - t0_;
+        GetRegistry().AddTime(name_, std::chrono::duration<double, std::milli>(dt).count());
+    }
+    ScopedTimer(const ScopedTimer &) = delete;
+    ScopedTimer &operator=(const ScopedTimer &) = delete;
+
+private:
+    const char *name_;
+    std::chrono::steady_clock::time_point t0_;
+};
+
+inline void Count(const char *name, double value) { GetRegistry().AddCount(name, value); }
+
+}  // namespace kiss_icp::prof
+
+#define KISS_PROF_CAT2(a, b) a##b
+#define KISS_PROF_CAT(a, b) KISS_PROF_CAT2(a, b)
+#define KISS_TIMER(name) ::kiss_icp::prof::ScopedTimer KISS_PROF_CAT(kiss_timer_, __LINE__)(name)
